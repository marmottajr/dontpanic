# DontPanic Web — multi-stage production image.
# Build context = repo root:  docker build -f Dockerfile.web -t dontpanic-web .
FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @dontpanic/shared build \
  && pnpm --filter @dontpanic/web build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app /app
WORKDIR /app/apps/web
EXPOSE 4200
CMD ["pnpm", "start"]
