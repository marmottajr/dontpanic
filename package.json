{
  "name": "dontpanic",
  "version": "0.0.0",
  "private": true,
  "description": "DontPanic — a production-grade full-stack boilerplate. The answer to building any system. (Marvin would say: 'Here I am, brain the size of a planet, scaffolding your CRUD app.')",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "audit": "pnpm audit --audit-level high",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx,json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "17.0.7",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "6.0.3"
  }
}
