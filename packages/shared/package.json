{
  "name": "@dontpanic/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./locale/br": {
      "types": "./dist/locale/br.d.ts",
      "import": "./dist/locale/br.js",
      "require": "./dist/locale/br.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@dontpanic/config": "workspace:*",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
