{
  "name": "@dontpanic/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dontpanic/config": "workspace:*",
    "eslint": "^10.5.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}