# ============================================================
#  DontPanic — environment template
#  Copy to .env and adjust. Don't Panic: dev defaults just work
#  with `docker compose up -d`. All ports live in the 42xx range
#  (yes, *that* 42) so they never clash with anything else.
# ============================================================

# ------------------- Docker host ports (42xx) ---------------
POSTGRES_PORT=4202
REDIS_PORT=4203
MINIO_PORT=4204
MINIO_CONSOLE_PORT=4205
MAILPIT_SMTP_PORT=4206
MAILPIT_UI_PORT=4207

# ---------------------------- API ---------------------------
NODE_ENV=development
API_PORT=4201
API_HOST=0.0.0.0

# --- Drivers / adapters (Hexagonal) — swap impl without touching domain ---
STORAGE_DRIVER=s3          # s3 | local
MAIL_DRIVER=smtp           # smtp | ses | console
CACHE_DRIVER=redis         # redis | memory
DB_PROVIDER=postgresql     # postgresql | mysql | sqlite (must match prisma/schema.prisma)

# Local storage adapter (STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4201/files

# SES mail adapter (MAIL_DRIVER=ses)
AWS_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=

# Database (Postgres)
DATABASE_URL=postgresql://dontpanic:dontpanic@localhost:4202/dontpanic?schema=public

# Redis (rate-limit, refresh-token rotation/blacklist, lockout)
REDIS_URL=redis://localhost:4203

# JWT — use long random secrets in production (>= 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-aaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-bbbbbbbbbbbbbbbb
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CSRF
CSRF_SECRET=dev-csrf-secret-change-me-cccccccccccccccccc

# URLs / CORS
WEB_ORIGIN=http://localhost:4200
API_PUBLIC_URL=http://localhost:4201

# 2FA (TOTP)
TOTP_ISSUER=DontPanic
# true: users MUST enable 2FA right after verifying their email (the app is
# locked until they do). false: a one-tap prompt on first login, snoozable 24h.
TWO_FACTOR_REQUIRED=false

# Mail (Mailpit in dev — UI at http://localhost:4207)
MAIL_HOST=localhost
MAIL_PORT=4206
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="DontPanic <no-reply@dontpanic.dev>"

# S3 / MinIO (console at http://localhost:4205)
S3_ENDPOINT=http://localhost:4204
S3_REGION=us-east-1
S3_BUCKET=dontpanic
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:4204/dontpanic

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------- WEB ---------------------------
WEB_PORT=4200
NEXT_PUBLIC_APP_NAME=DontPanic
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
# Server-side BFF proxy target (never exposed to the browser)
API_INTERNAL_URL=http://localhost:4201
NEXT_PUBLIC_SENTRY_DSN=
