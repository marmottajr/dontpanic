# ============================================================
#  DontPanic — environment template
#  Copy to .env and adjust. Don't Panic: dev defaults just work
#  with `docker compose up -d`.
# ============================================================

# ---------------------------- API ---------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0

# --- Drivers / adapters (Hexagonal) — swap impl without touching domain ---
STORAGE_DRIVER=s3          # s3 | local
MAIL_DRIVER=smtp           # smtp | ses | console
CACHE_DRIVER=redis         # redis | memory
DB_PROVIDER=postgresql     # postgresql | mysql | sqlite (must match prisma/schema.prisma)

# Local storage adapter (STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3001/files

# SES mail adapter (MAIL_DRIVER=ses)
AWS_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=

# Database (Postgres)
DATABASE_URL=postgresql://dontpanic:dontpanic@localhost:5432/dontpanic?schema=public

# Redis (rate-limit, refresh-token rotation/blacklist, lockout)
REDIS_URL=redis://localhost:6379

# JWT — use long random secrets in production (>= 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-aaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-bbbbbbbbbbbbbbbb
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CSRF
CSRF_SECRET=dev-csrf-secret-change-me-cccccccccccccccccc

# URLs / CORS
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# 2FA (TOTP)
TOTP_ISSUER=DontPanic

# Mail (Mailpit in dev — UI at http://localhost:8025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="DontPanic <no-reply@dontpanic.dev>"

# S3 / MinIO (console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dontpanic
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/dontpanic

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------- WEB ---------------------------
NEXT_PUBLIC_APP_NAME=DontPanic
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
# Server-side BFF proxy target (never exposed to the browser)
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=
