# ============================================================
#  DontPanic — environment template
#  Copy to .env and adjust. Don't Panic: dev defaults just work
#  with `docker compose up -d`. All ports live in the 42xx range
#  (yes, *that* 42) so they never clash with anything else.
# ============================================================

# ------------------- Docker host ports (42xx) ---------------
POSTGRES_PORT=4202
REDIS_PORT=4203
MINIO_PORT=4204
MINIO_CONSOLE_PORT=4205
MAILPIT_SMTP_PORT=4206
MAILPIT_UI_PORT=4207

# ---------------------------- API ---------------------------
NODE_ENV=development
API_PORT=4201
API_HOST=0.0.0.0

# --- Drivers / adapters (Hexagonal) — swap impl without touching domain ---
STORAGE_DRIVER=s3          # s3 | local
MAIL_DRIVER=smtp           # smtp | ses | console
CACHE_DRIVER=redis         # redis | memory
DB_PROVIDER=postgresql     # postgresql | mysql | sqlite (must match prisma/schema.prisma)

# Local storage adapter (STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4201/files

# SES mail adapter (MAIL_DRIVER=ses)
AWS_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database (Postgres) -- TWO connections, and the difference matters
# ---------------------------------------------------------------------------
# Multi-tenant isolation is enforced by Row Level Security. A SUPERUSER -- and
# any role with BYPASSRLS -- ignores RLS even with FORCE ROW LEVEL SECURITY on
# the tables, so the API must NOT connect as the database owner: every policy
# would be decoration. The API refuses to boot in production if it detects one.
#
#   DATABASE_URL        restricted role, used by the API at runtime (RLS applies)
#   DATABASE_ADMIN_URL  database owner, used only by migrate/seed (DDL)
#
# The restricted role is created by the *_app_role migration, which runs with
# the owner connection. On a fresh database, run the migration first.
DATABASE_URL=postgresql://dontpanic_app:dontpanic_app@localhost:4202/dontpanic?schema=public
DATABASE_ADMIN_URL=postgresql://dontpanic:dontpanic@localhost:4202/dontpanic?schema=public

# Redis (rate-limit, refresh-token rotation/blacklist, lockout)
REDIS_URL=redis://localhost:4203

# JWT — use long random secrets in production (>= 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-aaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-bbbbbbbbbbbbbbbb
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Seconds during which replaying an already-rotated refresh token counts as a
# concurrent rotation (two tabs) instead of theft. 0 = strict, no tolerance.
REFRESH_REUSE_GRACE=10

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CSRF
CSRF_SECRET=dev-csrf-secret-change-me-cccccccccccccccccc

# URLs / CORS
WEB_ORIGIN=http://localhost:4200
API_PUBLIC_URL=http://localhost:4201

# 2FA (TOTP)
TOTP_ISSUER=DontPanic
# true: users MUST enable 2FA right after verifying their email (the app is
# locked until they do). false: a one-tap prompt on first login, snoozable 24h.
TWO_FACTOR_REQUIRED=false

# Mail (Mailpit in dev — UI at http://localhost:4207)
MAIL_HOST=localhost
MAIL_PORT=4206
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="DontPanic <no-reply@dontpanic.dev>"

# S3 / MinIO (console at http://localhost:4205)
S3_ENDPOINT=http://localhost:4204
S3_REGION=us-east-1
S3_BUCKET=dontpanic
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:4204/dontpanic

# Rate limit (per route, per client IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
# Tighter budget for the unauthenticated auth surface: login, register,
# verify-email, resend-verification, 2fa/verify, forgot/reset-password.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=60000

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# `bullmq` puts work on Redis and a SEPARATE worker process consumes it
# (`pnpm --filter @dontpanic/api worker`). That split is the point: a slow SMTP
# host cannot slow a request, and a job that fails is retried instead of lost.
#
# `memory` runs jobs inline in whoever enqueued them — for tests and for
# `pnpm dev` without a worker. It is NOT a queue: no durability, no retry.
# Run the worker, or mail simply never leaves.
QUEUE_DRIVER=bullmq
QUEUE_NAME=dontpanic
# Namespaces the Redis keys, so two apps can share one Redis.
QUEUE_PREFIX={dontpanic}
QUEUE_CONCURRENCY=5
# Tries per job, including the first; backoff grows exponentially from
# QUEUE_BACKOFF milliseconds.
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF=2000

# ---------------------------------------------------------------------------
# Captcha  --  human verification on the unauthenticated forms
# ---------------------------------------------------------------------------
# Off by default so a fresh clone boots with no third-party keys. Turn it on
# before exposing the app publicly: the rate limit caps how FAST someone tries,
# the captcha caps whether a script can try at all.
#
# CAPTCHA_DRIVER: none | turnstile | recaptcha-v2 | recaptcha-v3
#   turnstile      Cloudflare Turnstile  -> https://dash.cloudflare.com/?to=/:account/turnstile
#   recaptcha-v2   Google checkbox       -> https://www.google.com/recaptcha/admin
#   recaptcha-v3   Google invisible score (no widget; tune CAPTCHA_MIN_SCORE)
# The web app MUST agree (NEXT_PUBLIC_CAPTCHA_DRIVER below) or every submit is
# rejected for a token the form never renders a way to obtain.
CAPTCHA_DRIVER=none
CAPTCHA_SECRET_KEY=
# reCAPTCHA v3 only: reject below this score. Google's own default is 0.5.
CAPTCHA_MIN_SCORE=0.5
CAPTCHA_TIMEOUT=5000
# Provider unreachable: false rejects the request (default), true lets it
# through. Fail-open trades bot protection for availability -- decide which one
# you would rather lose during a Cloudflare/Google outage.
CAPTCHA_FAIL_OPEN=false
# Public half, read by the browser. Site key is public by design.
NEXT_PUBLIC_CAPTCHA_DRIVER=none
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Client IP / proxy trust  --  READ THIS BEFORE DEPLOYING
# ---------------------------------------------------------------------------
# Every limit above buckets on the client IP, so these two settings decide
# whether the rate limiting actually works. They depend on WHERE you deploy,
# and the defaults below are the safe-but-restrictive local-dev values.
#
# TRUST_PROXY: who may set X-Forwarded-For on the way into the API.
#   false        no proxy; trust only the socket address
#   loopback     API and BFF on the same host   <- default, `pnpm dev`
#   uniquelocal  private ranges                 <- docker-compose.dev.yml
#   2            number of trusted hops
#   10.0.0.0/8   explicit IP/CIDR allowlist     <- most precise, prefer in prod
# NEVER `true` in production: it trusts every hop, so any caller can forge the
# header and get a fresh rate-limit bucket per request.
TRUST_PROXY=loopback
#
# CLIENT_IP_HEADER / CLIENT_IP_TRUSTED_HOPS: how the web BFF learns the real
# client IP before forwarding it to the API. Hops counts from the right, since
# load balancers append. 0 = nothing trusted in front of the web app, so no IP
# is forwarded and the API sees every user as one client.
#   nginx / Traefik     x-real-ip                 hops 1
#   AWS ALB / GCP LB    x-forwarded-for           hops 1
#   Cloudflare          cf-connecting-ip          hops 1
#   Cloudflare -> ALB   x-forwarded-for           hops 2
#   Vercel              x-vercel-forwarded-for    hops 1
#   Fly.io              fly-client-ip             hops 1
CLIENT_IP_HEADER=x-forwarded-for
CLIENT_IP_TRUSTED_HOPS=0

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900

# Observability (optional) — Sentry is a no-op until a DSN is set
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------- WEB ---------------------------
WEB_PORT=4200
NEXT_PUBLIC_APP_NAME=DontPanic
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
# Server-side BFF proxy target (never exposed to the browser)
API_INTERNAL_URL=http://localhost:4201
NEXT_PUBLIC_SENTRY_DSN=
